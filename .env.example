# ─────────────────────────────────────────────────────────────────────────────
# RailDrishti AI – Environment Configuration
# Copy to .env and fill in real values before running.
# The app starts in memory-only mode if DATABASE_URL is unreachable.
# ─────────────────────────────────────────────────────────────────────────────

# Project metadata
PROJECT_NAME="RailDrishti AI"
VERSION="1.0.0"

# Set to true to run entirely with simulated data (no external DB required)
PROTOTYPE_MODE=true

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Leave blank or omit to run in memory-only mode.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/raildrishti

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional – not required for prototype; used for live cache.
REDIS_URL=redis://localhost:6379/0

# ── API Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (default allows localhost dev)
# BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Data Source Mode ──────────────────────────────────────────────────────────
# Options: SIMULATOR | LIVE_API | HYBRID | PRODUCTION_AUTHORIZED
# Default: SIMULATOR (kinematic simulator, no external API needed)
DATA_SOURCE_MODE=SIMULATOR

# ── External Train Status Provider ────────────────────────────────────────────
# Disabled by default. Set LIVE_DATA_MODE=true to enable external feed.
LIVE_DATA_MODE=false
TRAIN_STATUS_PROVIDER=generic_http
TRAIN_STATUS_API_BASE_URL=
TRAIN_STATUS_API_KEY=your_api_key_here
TRAIN_STATUS_AUTH_HEADER=Authorization
TRAIN_STATUS_AUTH_PREFIX=Bearer
TRAIN_STATUS_ENDPOINT_TEMPLATE=/trains/{train_number}/live
TRAIN_STATUS_POLL_SECONDS=60
TRAIN_STATUS_CONNECT_TIMEOUT=10.0
TRAIN_STATUS_READ_TIMEOUT=15.0
TRAIN_STATUS_MAX_RETRIES=3

# ── Weather Provider ──────────────────────────────────────────────────────────
# Disabled by default. Synthetic weather simulation is used unless enabled.
WEATHER_PROVIDER=generic_http
WEATHER_API_BASE_URL=
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_ENABLED=false

# ── Simulator Persistence ─────────────────────────────────────────────────────
# Interval in seconds for persisting train state snapshots to PostgreSQL
SIMULATOR_PERSIST_INTERVAL=30
